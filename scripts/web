#!/usr/bin/env bash
# Make sure the web container is up and open the chronicle in a browser.
# Doesn't start the tick loop — use ./scripts/up for both.

set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_lib.sh"

require_docker
require_minimax_key
ensure_image_built

step "starting web on http://localhost:8534"
"${COMPOSE[@]}" up -d --no-deps web

if command -v open >/dev/null 2>&1; then
  ( sleep 2 && open "http://localhost:8534" ) &
fi
ok "web running (./scripts/down to stop)"
