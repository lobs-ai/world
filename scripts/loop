#!/usr/bin/env bash
# Run the tick loop forever. Cadence comes from WORLD_TICK_INTERVAL_SECONDS
# (default 900s = 15 min). Ctrl-C to stop.
#
# Usage:
#   ./scripts/loop                # auto-pick or prompt
#   ./scripts/loop <worldId>

set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_lib.sh"

require_node
require_minimax_key
ensure_install
ensure_app_built

worldId="$(resolve_world_id "${1:-}")"
step "tick loop running for $(color_dim "$worldId")"
echo "  cadence: ${WORLD_TICK_INTERVAL_SECONDS:-900}s   (override in .env)"
echo "  Ctrl-C to stop"
echo
exec npm run --silent --workspace=app tick:loop -- "$worldId"
