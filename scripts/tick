#!/usr/bin/env bash
# Run one tick on a world. Auto-selects the world if there is only one.
#
# Usage:
#   ./scripts/tick                # auto-pick or prompt
#   ./scripts/tick <worldId>
#   ./scripts/tick --n 5          # run 5 ticks back to back

set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_lib.sh"

require_docker
require_minimax_key
ensure_image_built

count=1
worldId=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --n|-n) count="$2"; shift 2 ;;
    *)      worldId="$1"; shift ;;
  esac
done

worldId="$(resolve_world_id "$worldId")"
step "ticking world $(color_dim "$worldId") · $count tick(s)"

for i in $(seq 1 "$count"); do
  if (( count > 1 )); then
    echo "$(color_blue "─── tick $i/$count ───")"
  fi
  run_app_oneshot npm run --silent --workspace=app tick -- "$worldId"
done
ok "done"
