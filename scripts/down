#!/usr/bin/env bash
# Stop the web + tick containers. Data on disk (./data/world.db) is
# preserved. Add `--volumes` if you also want to drop the named volumes
# (we don't use any right now, but compose may add them in future).
#
# Usage:
#   ./scripts/down

set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_lib.sh"

require_docker

step "stopping web + tick"
"${COMPOSE[@]}" down
ok "stopped"
