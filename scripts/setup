#!/usr/bin/env bash
# One-time setup: install deps, build app, copy .env.example, prompt for key.
# Idempotent — safe to re-run.

set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_lib.sh"

require_node

if [[ ! -f "$ROOT/.env" ]]; then
  step "creating .env from .env.example"
  cp "$ROOT/.env.example" "$ROOT/.env"
  ok ".env created"
  echo
  echo "$(color_yellow "→ open .env and set MINIMAX_API_KEY=<your-key>")"
  echo "   then re-run: ./scripts/setup"
  exit 0
fi

# shellcheck disable=SC1091
source "$ROOT/.env"
if [[ -z "${MINIMAX_API_KEY:-}" ]]; then
  err "MINIMAX_API_KEY is empty in .env. Set it and re-run."
  exit 2
fi

step "installing workspace dependencies"
npm install
ok "dependencies installed"

step "building app workspace"
npm run build --workspace=app
ok "app built"

step "creating data directory"
mkdir -p "$ROOT/data"
ok "ready"

echo
echo "Next:"
echo "  ./scripts/genesis \"A kingdom where the king has been dying for forty years.\""
echo "  ./scripts/tick                  # one tick on the only/selected world"
echo "  ./scripts/loop                  # tick forever, every 15 minutes"
echo "  ./scripts/web                   # open the chronicle in a browser"
