#!/usr/bin/env bash
# One-time setup: copy .env.example, prompt for MINIMAX_API_KEY, build the
# world:latest Docker image. Idempotent — safe to re-run.

set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_lib.sh"

require_docker

if [[ ! -f "$ROOT/.env" ]]; then
  step "creating .env from .env.example"
  cp "$ROOT/.env.example" "$ROOT/.env"
  ok ".env created"
fi

# shellcheck disable=SC1091
source "$ROOT/.env"
if [[ -z "${MINIMAX_API_KEY:-}" ]]; then
  echo
  echo "$(color_yellow "MINIMAX_API_KEY is not set in .env.")"
  printf "Paste it now (or Ctrl-C to abort): "
  read -r key
  if [[ -z "$key" ]]; then
    err "no key given"
    exit 2
  fi
  upsert_env MINIMAX_API_KEY "$key"
  ok "key saved to .env"
fi

mkdir -p "$ROOT/data"
rebuild_image

echo
echo "Next:"
echo "  ./scripts/genesis \"A kingdom where the king has been dying for forty years.\""
echo "  ./scripts/up                    # start web + tick loop in the background"
echo "  ./scripts/web                   # open the chronicle in a browser"
