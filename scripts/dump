#!/usr/bin/env bash
# Dump a world's chronicle as markdown to stdout. With no argument, lists
# all worlds.
#
# Usage:
#   ./scripts/dump                # list worlds
#   ./scripts/dump <worldId>      # dump that world's chronicle

set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_lib.sh"

require_docker
ensure_image_built

if [[ $# -eq 0 ]]; then
  run_app_oneshot npm run --silent --workspace=app dump
else
  run_app_oneshot npm run --silent --workspace=app dump -- "$1"
fi
