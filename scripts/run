#!/usr/bin/env bash
# scripts/run — one command to do it all, dockerized.
#
# In order, this script:
#   1. checks Docker, copies .env if missing, asks for MINIMAX_API_KEY
#   2. builds the world:latest image if it doesn't exist
#   3. seeds a world if there are none yet (prompts for premise; -f <path> ok)
#   4. starts web + tick loop in the background via docker compose
#   5. opens the browser to the chronicle
#
# Stop everything with: ./scripts/down
#
# Usage:
#   ./scripts/run                          # interactive (prompts for premise if no worlds)
#   ./scripts/run -f path/to/premise.txt   # seed from a file (only used on first run)
#   ./scripts/run path/to/premise.txt      # auto-detected as a file

set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_lib.sh"

# ── 1. preflight ────────────────────────────────────────────────────────────
require_docker

if [[ ! -f "$ROOT/.env" ]]; then
  step "creating .env from .env.example"
  cp "$ROOT/.env.example" "$ROOT/.env"
  ok ".env created"
fi

# shellcheck disable=SC1091
source "$ROOT/.env"
if [[ -z "${MINIMAX_API_KEY:-}" ]]; then
  echo
  echo "$(color_yellow "MINIMAX_API_KEY is not set in .env.")"
  printf "Paste it now (or Ctrl-C to abort): "
  read -r key
  if [[ -z "$key" ]]; then
    err "no key given"
    exit 2
  fi
  upsert_env MINIMAX_API_KEY "$key"
  export MINIMAX_API_KEY="$key"
  ok "key saved to .env"
fi

# ── 2. build image ──────────────────────────────────────────────────────────
mkdir -p "$ROOT/data"
ensure_image_built

# ── 3. parse optional premise/file arg (only used if no worlds yet) ────────
if ! parse_premise_args "$@"; then
  err "$PREMISE_ERROR"
  exit 2
fi
run_premise="$PREMISE"

# ── 4. seed a world if none exist ──────────────────────────────────────────
worlds_blob="$(list_worlds_compact 2>/dev/null || true)"
if [[ -z "$worlds_blob" ]]; then
  echo
  step "no worlds yet — let's seed one"
  default_premise="A kingdom where the king has been dying for forty years."
  if [[ -z "$run_premise" ]]; then
    printf "premise [%s] (or a path to a file)\n> " "$(color_dim "$default_premise")"
    read -r premise
    if [[ -n "$premise" && -f "$premise" ]]; then
      premise="$(cat "$premise")"
    fi
    premise="${premise:-$default_premise}"
  else
    premise="$run_premise"
  fi
  step "seeding world (one LLM call, ~20–40s)"
  run_app_oneshot npm run --silent --workspace=app genesis -- "$premise"
  ok "world seeded"
elif [[ -n "$run_premise" ]]; then
  echo
  step "(world already exists; ignoring premise argument)"
fi

worldId="$(resolve_world_id "")"
upsert_env WORLD_ID "$worldId"

# ── 5. start web + tick in the background ──────────────────────────────────
step "starting web + tick (worldId=$(color_dim "$worldId"))"
"${COMPOSE[@]}" up -d
URL="http://localhost:8534/world/$worldId"
ok "running"
echo
ok "world id     $(color_dim "$worldId")"
ok "chronicle    $(color_blue "$URL")"
ok "logs         $(color_dim "./scripts/logs")"
ok "stop         $(color_dim "./scripts/down")"
echo

if command -v open >/dev/null 2>&1; then
  ( sleep 2 && open "$URL" ) &
fi
