#!/usr/bin/env bash
# scripts/run — one command to do it all.
#
# In order, this script:
#   1. checks Node, copies .env if missing, asks for MINIMAX_API_KEY
#   2. installs npm deps if not present
#   3. builds the app workspace if not built / stale
#   4. seeds a world if there are none yet (prompts for premise)
#   5. runs the tick loop in the background (every WORLD_TICK_INTERVAL_SECONDS)
#   6. starts the Next.js dev server on :3000 and opens the browser
#
# The chronicle may be empty for the first tick interval — that's expected;
# the background loop will populate it.
#
# Ctrl-C stops both the loop and the web server cleanly.

set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_lib.sh"

# ── 1. preflight ────────────────────────────────────────────────────────────
require_node

if [[ ! -f "$ROOT/.env" ]]; then
  step "creating .env from .env.example"
  cp "$ROOT/.env.example" "$ROOT/.env"
  ok ".env created"
fi

# shellcheck disable=SC1091
source "$ROOT/.env"
if [[ -z "${MINIMAX_API_KEY:-}" ]]; then
  echo
  echo "$(color_yellow "MINIMAX_API_KEY is not set in .env.")"
  printf "Paste it now (or Ctrl-C to abort): "
  read -r key
  if [[ -z "$key" ]]; then
    err "no key given"
    exit 2
  fi
  # Replace or append the line in .env
  if grep -q '^MINIMAX_API_KEY=' "$ROOT/.env"; then
    # macOS sed wants -i ''
    sed -i '' "s|^MINIMAX_API_KEY=.*|MINIMAX_API_KEY=$key|" "$ROOT/.env"
  else
    printf '\nMINIMAX_API_KEY=%s\n' "$key" >> "$ROOT/.env"
  fi
  export MINIMAX_API_KEY="$key"
  ok "key saved to .env"
fi

# ── 2. install + build ──────────────────────────────────────────────────────
ensure_install
ensure_app_built
mkdir -p "$ROOT/data"

# ── 3. seed a world if none exists ─────────────────────────────────────────
worlds_blob="$(npm --silent run dump --workspace=app 2>/dev/null || true)"
if [[ -z "$worlds_blob" || "$worlds_blob" == *"no worlds"* ]]; then
  echo
  step "no worlds yet — let's seed one"
  default_premise="A kingdom where the king has been dying for forty years."
  printf "premise [%s]\n> " "$(color_dim "$default_premise")"
  read -r premise
  premise="${premise:-$default_premise}"
  step "seeding world (one LLM call, ~20–40s)"
  npm run --silent --workspace=app genesis -- "$premise"
  ok "world seeded"
fi

worldId="$(resolve_world_id "")"

# ── 4. start tick loop in background ───────────────────────────────────────
LOG_DIR="$ROOT/data/logs"
mkdir -p "$LOG_DIR"
TICK_LOG="$LOG_DIR/tick.log"

step "starting tick loop (cadence ${WORLD_TICK_INTERVAL_SECONDS:-900}s) → $TICK_LOG"
npm run --silent --workspace=app tick:loop -- "$worldId" >>"$TICK_LOG" 2>&1 &
LOOP_PID=$!

cleanup() {
  echo
  step "shutting down"
  if kill -0 "$LOOP_PID" 2>/dev/null; then
    kill "$LOOP_PID" 2>/dev/null || true
    wait "$LOOP_PID" 2>/dev/null || true
  fi
  if [[ -n "${WEB_PID:-}" ]] && kill -0 "$WEB_PID" 2>/dev/null; then
    kill "$WEB_PID" 2>/dev/null || true
    wait "$WEB_PID" 2>/dev/null || true
  fi
  ok "stopped"
}
trap cleanup EXIT INT TERM

# ── 5. start the web server ────────────────────────────────────────────────
URL="http://localhost:3000/world/$worldId"
echo
ok "world id     $(color_dim "$worldId")"
ok "tick log     $(color_dim "tail -f $TICK_LOG")"
ok "chronicle    $(color_blue "$URL")"
echo

# Try to open the browser (macOS).
if command -v open >/dev/null 2>&1; then
  ( sleep 2 && open "$URL" ) &
fi

# Hand foreground over to next dev so its output streams to the user.
npm run --silent --workspace=web dev &
WEB_PID=$!
wait "$WEB_PID"
