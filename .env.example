# Minimax — primary LLM provider
MINIMAX_API_KEY=

# Model ids passed through @agentic/llm. Default model is the M2 family.
WORLD_MODEL_DIRECTOR=minimax/MiniMax-M2.7
WORLD_MODEL_CHARACTER=minimax/MiniMax-M2.7
WORLD_MODEL_SCRIBE=minimax/MiniMax-M2.7
WORLD_MODEL_GENESIS=minimax/MiniMax-M2.7

# Database location (relative to repo root). SQLite file.
WORLD_DB=data/world.db

# Tick cadence for the worker, in seconds. 900 = 15 minutes.
WORLD_TICK_INTERVAL_SECONDS=900
